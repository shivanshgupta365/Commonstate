{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://commonstate.example/schemas/dedicated-deployment-manifest-v1.json",
  "title": "Commonstate vendor-managed dedicated deployment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "customer",
    "region",
    "domain",
    "vercel",
    "supabase",
    "fly",
    "secrets",
    "monitoring",
    "retention"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "customer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "displayName", "environment"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,39}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "environment": { "enum": ["staging", "production"] }
      }
    },
    "region": { "type": "string", "minLength": 2 },
    "domain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostname", "certificateMode"],
      "properties": {
        "hostname": { "type": "string", "format": "hostname" },
        "certificateMode": { "const": "managed" }
      }
    },
    "vercel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["teamId", "projectName", "gitRef", "runtimeRegion"],
      "properties": {
        "teamId": { "type": "string", "minLength": 1 },
        "projectName": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "gitRef": { "type": "string", "minLength": 7 },
        "runtimeRegion": { "type": "string", "minLength": 2 }
      }
    },
    "supabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "projectRef", "region", "pointInTimeRecovery", "storageBucket"],
      "properties": {
        "organizationId": { "type": "string", "minLength": 1 },
        "projectRef": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 2 },
        "pointInTimeRecovery": { "const": true },
        "storageBucket": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    },
    "fly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organization", "appName", "region", "machineSize", "minMachines", "command"],
      "properties": {
        "organization": { "type": "string", "minLength": 1 },
        "appName": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "region": { "type": "string", "minLength": 3 },
        "machineSize": { "type": "string", "minLength": 1 },
        "minMachines": { "type": "integer", "minimum": 1 },
        "command": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^[a-z][a-z0-9-]+://.+$" },
      "required": ["databaseUrl", "productDatabaseUrl", "migrationDatabaseUrl", "supabaseServiceRoleKey", "encryptionKey"],
      "properties": {
        "databaseUrl": { "type": "string", "pattern": "^[a-z][a-z0-9-]+://.+$" },
        "productDatabaseUrl": { "type": "string", "pattern": "^[a-z][a-z0-9-]+://.+$" },
        "migrationDatabaseUrl": { "type": "string", "pattern": "^[a-z][a-z0-9-]+://.+$" },
        "supabaseServiceRoleKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]+://.+$" },
        "encryptionKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]+://.+$" }
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healthUrl", "alertChannel", "errorBudgetPercent", "backupCheckSchedule"],
      "properties": {
        "healthUrl": { "type": "string", "format": "uri" },
        "alertChannel": { "type": "string", "minLength": 1 },
        "errorBudgetPercent": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
        "backupCheckSchedule": { "type": "string", "minLength": 9 }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceBodyDays", "runEventDays", "auditEventDays"],
      "properties": {
        "sourceBodyDays": { "type": "integer", "minimum": 1 },
        "runEventDays": { "type": "integer", "minimum": 1 },
        "auditEventDays": { "type": ["integer", "null"], "minimum": 1 }
      }
    }
  }
}
