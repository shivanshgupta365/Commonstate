# Supabase transaction pooler URL used by the running application.
# Prepared statements are disabled in db/index.ts for transaction-pooler compatibility.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Restricted runtime role used only after a user/service identity and workspace
# membership have been resolved. This role must not own tables or bypass RLS.
PRODUCT_DATABASE_URL=postgresql://commonstate_runtime.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres

# Direct or session-pooler URL used only by Drizzle migrations.
MIGRATION_DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Canonical origin for metadata and social cards.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional conservative connection-pool size for serverless instances.
POSTGRES_POOL_MAX=3
PRODUCT_POSTGRES_POOL_MAX=3

# Browser/server authentication. The service-role key is server-only and must
# never use the NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
# Private bucket for immutable customer source files. Create it before enabling
# authenticated signed uploads; the API never falls back to local disk/storage.
SUPABASE_SOURCE_BUCKET=commonstate-sources

# Enterprise SSO and directory provisioning.
WORKOS_CLIENT_ID=client_REPLACE_ME
WORKOS_API_KEY=sk_REPLACE_ME
WORKOS_WEBHOOK_SECRET=whsec_REPLACE_ME

# Local developer convenience. Production and preview deployments must leave
# this false; authenticated product routes never fall back to recorded data.
COMMONSTATE_LOCAL_AUTH=false

# Managed model providers. A workspace may instead reference an encrypted BYOK
# credential. Missing keys produce a typed provider-not-configured result.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Connector OAuth/webhook settings. COMMONSTATE_WEBHOOK_SECRET is a
# deployment master; the receiver derives a distinct secret per connector.
COMMONSTATE_WEBHOOK_SECRET=
COMMONSTATE_CREDENTIAL_ENCRYPTION_KEY=
COMMONSTATE_CREDENTIAL_PEPPER=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Worker and observability.
WORKER_ID=worker-local
WORKER_HEALTH_PORT=8080
WORKER_IDLE_POLL_MS=1000
WORKER_FAILURE_BACKOFF_MS=5000
# Optional absolute file URL or package exporting createHandlers({ sql, environment }).
WORKER_HANDLER_MODULE=
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
