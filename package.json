{
  "name": "commonstate-tano-edition",
  "version": "0.1.0",
  "private": true,
  "author": "Shivansh Gupta",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:domain": "node --test tests/domain.test.mjs",
    "test:e2e": "npm run build && playwright test",
    "demo:record": "node --experimental-transform-types scripts/generate-recorded-fixture.ts",
    "playwright:install": "playwright install --with-deps chromium",
    "typecheck": "tsc --noEmit --pretty false",
    "lint": "eslint . --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "postgres": "3.4.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3"
  },
  "type": "module"
}
